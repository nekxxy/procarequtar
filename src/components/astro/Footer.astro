---
import { localizedHref, t, type Locale } from "../../i18n/utils";
import Logo from "./Logo.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cols = [
  {
    title: t(lang, "nav.services"),
    items: [
      { href: localizedHref("/services/construction", lang), label: t(lang, "services.list.construction.title") },
      { href: localizedHref("/services/post-construction-cleaning", lang), label: t(lang, "services.list.post-construction-cleaning.title") },
      { href: localizedHref("/services/building-materials", lang), label: t(lang, "services.list.building-materials.title") },
      { href: localizedHref("/services/facility-maintenance", lang), label: t(lang, "services.list.facility-maintenance.title") },
      { href: localizedHref("/services/pest-control", lang), label: t(lang, "services.list.pest-control.title") },
    ],
  },
  {
    title: t(lang, "nav.about"),
    items: [
      { href: localizedHref("/about", lang), label: t(lang, "nav.about") },
      { href: localizedHref("/projects", lang), label: t(lang, "nav.projects") },
      { href: localizedHref("/contact", lang), label: t(lang, "nav.contact") },
    ],
  },
  {
    title: t(lang, "nav.contact"),
    items: [
      { href: "mailto:hello@procareqatar.com", label: "hello@procareqatar.com" },
      { href: "tel:+97400000000", label: "+974 0000 0000" },
      { href: "https://wa.me/97400000000", label: "WhatsApp" },
    ],
  },
];
---

<footer class="relative bg-[var(--color-bg-dark)] text-[var(--color-fg-dark)]" data-theme-section="dark">
  <div class="mx-auto grid max-w-[100rem] grid-cols-1 gap-12 px-6 py-20 md:grid-cols-12 md:px-10 md:py-28">
    <div class="md:col-span-5">
      <Logo className="text-white" />
      <p class="mt-6 max-w-md text-base text-white/65">{t(lang, "footer.tagline")}</p>
      <p class="mt-10 font-mono text-xs uppercase tracking-[0.25em] text-white/45">
        {t(lang, "footer.registry")}
      </p>
    </div>
    {
      cols.map((c) => (
        <nav class="md:col-span-2" aria-label={c.title}>
          <h4 class="mb-5 font-mono text-[0.65rem] uppercase tracking-[0.3em] text-white/45">
            {c.title}
          </h4>
          <ul class="space-y-2.5 text-sm">
            {c.items.map((i) => (
              <li>
                <a
                  href={i.href}
                  data-cursor-hover
                  class="text-white/80 hover:text-[var(--color-accent)] transition-colors"
                >
                  {i.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <div class="md:col-span-1 md:flex md:justify-end">
      <a
        href="#main"
        data-cursor-hover
        class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/15 text-white/70 transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        aria-label="Back to top"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 11V3M3 7l4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-[100rem] flex-col items-start justify-between gap-2 px-6 py-6 text-xs text-white/45 md:flex-row md:items-center md:px-10">
      <span>{t(lang, "footer.rights")}</span>
      <span class="font-mono uppercase tracking-[0.2em]">Built in Doha</span>
    </div>
  </div>
</footer>
