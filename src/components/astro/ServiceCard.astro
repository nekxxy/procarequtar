---
import ServiceIcon from "../react/ServiceIcon";
import type { ServiceSlug } from "../../i18n/utils";

interface Props {
  index: string;
  code: string;
  title: string;
  tagline: string;
  href: string;
  ctaLabel: string;
  slug: ServiceSlug;
}
const { index, code, title, tagline, href, ctaLabel, slug } = Astro.props;
---

<a
  href={href}
  data-cursor-hover
  class="service-card group relative block overflow-hidden rounded-[var(--radius-xl)] border border-[color-mix(in_srgb,var(--fg)_12%,transparent)] bg-[color-mix(in_srgb,var(--fg)_3%,transparent)] p-8 transition-colors hover:border-[var(--color-accent)] md:p-10"
>
  <div class="mb-8 flex items-start justify-between text-xs">
    <span class="font-mono uppercase tracking-[0.25em] text-[var(--muted)]">
      {index}
    </span>
    <span
      class="rounded-full border border-[color-mix(in_srgb,var(--fg)_15%,transparent)] px-3 py-1 font-mono text-[0.65rem] tracking-widest text-[var(--muted)]"
    >
      {code}
    </span>
  </div>
  <ServiceIcon
    client:visible
    slug={slug}
    className="mb-10 h-16 w-16 text-[var(--fg)] group-hover:text-[var(--color-accent)] transition-colors"
  />
  <h3 class="display text-3xl md:text-4xl">{title}</h3>
  <p class="mt-3 text-base text-[var(--muted)]">{tagline}</p>
  <span class="mt-8 inline-flex items-center gap-2 text-sm text-[var(--color-accent)] transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1">
    {ctaLabel}
    <svg
      width="16"
      height="16"
      viewBox="0 0 18 18"
      fill="none"
      aria-hidden="true"
      class="rtl:rotate-180"
    >
      <path
        d="M3 9h12M11 4l5 5-5 5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -bottom-32 h-44 bg-[radial-gradient(60%_60%_at_50%_50%,var(--color-accent)/0.18,transparent_70%)] opacity-0 transition-opacity duration-700 group-hover:opacity-100"
  >
  </div>
</a>
