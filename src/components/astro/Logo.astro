---
import { getLangFromUrl, localizedHref } from "../../i18n/utils";

interface Props {
  className?: string;
}
const { className } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<a
  href={localizedHref("/", lang)}
  data-cursor-hover
  aria-label="Pro Care Qatar — home"
  class:list={["inline-flex items-center gap-2.5", className]}
>
  <svg
    width="28"
    height="28"
    viewBox="0 0 28 28"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="14" cy="14" r="13" stroke="currentColor" stroke-width="1.5" />
    <path
      d="M9 19V9h4.4a3.4 3.4 0 0 1 0 6.8H9"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="20" cy="9.5" r="1.4" fill="var(--color-accent)" />
  </svg>
  <span class="display text-base tracking-tight">Pro Care</span>
</a>
