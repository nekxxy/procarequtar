---
import type { Locale } from "../../i18n/utils";
import Hero from "./Hero.astro";
import MarqueeBand from "./MarqueeBand.astro";
import ServicesShowcase from "./ServicesShowcase.astro";
import RevealSection from "./RevealSection.astro";
import ProcessSection from "./ProcessSection.astro";
import ProjectsTeaser from "./ProjectsTeaser.astro";
import StatsBand from "./StatsBand.astro";
import AboutTeaser from "./AboutTeaser.astro";
import CtaBand from "./CtaBand.astro";
import ThemeMorph from "../react/ThemeMorph.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<ThemeMorph client:idle />

<Hero lang={lang} />

<MarqueeBand lang={lang} />

<ServicesShowcase lang={lang} />

<RevealSection lang={lang} />

<ProcessSection lang={lang} />

<ProjectsTeaser lang={lang} />

<StatsBand lang={lang} />

<AboutTeaser lang={lang} />

<CtaBand lang={lang} />
