---
import {
  defaultLocale,
  type Locale,
  isLocale,
} from "../../i18n/utils";
import MinimalHero from "./MinimalHero.astro";
import ScrollSequenceSection from "./ScrollSequenceSection.astro";
import CredentialsStrip from "./CredentialsStrip.astro";
import CapabilitiesList from "./CapabilitiesList.astro";
import HomeStatsBand from "./HomeStatsBand.astro";
import HomeMarquee from "./HomeMarquee.astro";
import ManifestoCard from "./ManifestoCard.astro";
import MinimalFooter from "./MinimalFooter.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const otherLocale: Locale = lang === "en" ? "ar" : "en";
// keep imports referenced (defaults / type guards exist for future use)
void isLocale;
void defaultLocale;
---

<MinimalHero lang={lang} />

<ScrollSequenceSection lang={lang} />

<CredentialsStrip lang={lang} />

<CapabilitiesList lang={lang} />

<HomeMarquee lang={lang} />

<ManifestoCard lang={lang} />

<HomeStatsBand lang={lang} />

<MinimalFooter lang={lang} otherLocale={otherLocale} />
