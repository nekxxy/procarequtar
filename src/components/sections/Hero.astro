---
import { t, tn, localizedHref, type Locale } from "../../i18n/utils";
import SplitText from "../react/SplitText.tsx";
import HeroRotator from "../react/HeroRotator.tsx";
import MagneticButton from "../react/MagneticButton.tsx";
import IsometricTower from "../react/IsometricTower.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const rotators = tn<string[]>(lang, "home.hero.headlineRotators");
---

<section
  class="relative min-h-[100svh] overflow-hidden bg-[var(--color-bg)] text-[var(--color-fg)] grain"
  data-theme-section="light"
>
  <!-- Ambient gradient orbs -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -end-32 h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle,var(--color-accent)_0%,transparent_60%)] opacity-30 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-24 start-1/4 h-[28rem] w-[28rem] rounded-full bg-[radial-gradient(circle,var(--color-accent-3)_0%,transparent_60%)] opacity-20 blur-3xl"
  >
  </div>

  <!-- Subtle perspective grid floor -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-[40svh] w-full opacity-60"
    viewBox="0 0 1600 600"
    preserveAspectRatio="none"
  >
    <defs>
      <linearGradient id="hero-grid-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--color-fg)" stop-opacity="0" />
        <stop offset="0.6" stop-color="var(--color-fg)" stop-opacity="0.18" />
        <stop offset="1" stop-color="var(--color-fg)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g stroke="url(#hero-grid-fade)" stroke-width="1" fill="none">
      {Array.from({ length: 16 }).map((_, i) => {
        const t = (i + 1) / 17;
        const x1 = -200 + t * 2000;
        const x2 = 800 + (t - 0.5) * 200;
        return <line x1={x1} y1={600} x2={x2} y2={120} />;
      })}
      {Array.from({ length: 8 }).map((_, i) => {
        const t = i / 8;
        const y = 120 + t * 480;
        return <line x1={0} y1={y} x2={1600} y2={y} stroke-opacity={1 - t * 0.6} />;
      })}
    </g>
  </svg>

  <div class="relative z-[2] mx-auto grid w-full max-w-[100rem] grid-cols-1 gap-10 px-6 pb-16 pt-36 md:px-10 md:pb-24 md:pt-44 lg:grid-cols-12 lg:gap-16">
    <div class="flex flex-col gap-10 md:gap-14 lg:col-span-7">
      <span class="eyebrow inline-flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
        {t(lang, "home.hero.eyebrow")}
      </span>

      <h1 class="display text-balance text-[clamp(2.75rem,7.5vw,7.5rem)] leading-[0.95]">
        <SplitText client:visible split="words" stagger={0.06}>
          {t(lang, "home.hero.headlinePre")}
        </SplitText>
        <span class="block">
          <HeroRotator client:visible words={rotators} />
        </span>
      </h1>

      <p class="max-w-xl text-lg text-[var(--muted)] md:text-xl">
        {t(lang, "home.hero.lead")}
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <MagneticButton client:visible href={localizedHref("/contact", lang)} variant="solid">
          {t(lang, "home.hero.primaryCta")}
        </MagneticButton>
        <MagneticButton client:visible href={localizedHref("/projects", lang)} variant="outline">
          {t(lang, "home.hero.secondaryCta")}
        </MagneticButton>
      </div>

      <div class="mt-12 flex items-center gap-4 md:mt-20">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.3em] text-[var(--muted)]">
          {t(lang, "home.hero.scrollHint")}
        </span>
        <span aria-hidden="true" class="h-px w-16 bg-[color-mix(in_srgb,var(--fg)_20%,transparent)]"></span>
      </div>
    </div>

    <!-- Animated tower scene (desktop & tablet) -->
    <div class="hidden lg:col-span-5 lg:flex lg:items-center lg:justify-center">
      <IsometricTower client:visible />
    </div>
  </div>
</section>
