---
import { t, tn, localizedHref, type Locale } from "../../i18n/utils";
import RevealOnScroll from "../react/RevealOnScroll.tsx";
import MagneticButton from "../react/MagneticButton.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface Value {
  title: string;
  body: string;
}
const values = tn<Value[]>(lang, "about.values");
---

<section class="bg-[var(--color-bg)] text-[var(--color-fg)] grain relative" data-theme-section="light">
  <div class="mx-auto grid max-w-[100rem] grid-cols-1 gap-12 px-6 pb-16 pt-44 md:grid-cols-12 md:gap-16 md:px-10 md:pb-24 md:pt-56">
    <div class="md:col-span-5">
      <span class="eyebrow inline-flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
        {t(lang, "nav.about")}
      </span>
    </div>
    <div class="md:col-span-7 flex flex-col gap-8">
      <h1 class="display text-balance text-[clamp(2.5rem,7vw,6rem)] leading-[0.96]">
        {t(lang, "about.title")}
      </h1>
      <p class="max-w-2xl text-xl text-[var(--muted)]">{t(lang, "about.lead")}</p>
    </div>
  </div>
</section>

<section class="bg-[var(--color-bg)] text-[var(--color-fg)]">
  <div class="mx-auto grid max-w-[100rem] grid-cols-1 gap-12 px-6 py-24 md:grid-cols-12 md:gap-16 md:px-10 md:py-32">
    <RevealOnScroll client:visible className="md:col-span-7">
      <p class="max-w-3xl text-lg leading-relaxed text-[var(--fg)] md:text-xl">{t(lang, "about.story")}</p>
    </RevealOnScroll>
    <RevealOnScroll client:visible className="md:col-span-5">
      <dl class="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-[color-mix(in_srgb,var(--fg)_10%,transparent)] bg-[color-mix(in_srgb,var(--fg)_8%,transparent)]">
        <div class="bg-[var(--color-bg)] p-6">
          <dt class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--muted)]">
            {t(lang, "about.registryLabel")}
          </dt>
          <dd class="mt-3 display text-3xl">{t(lang, "about.registryNumber")}</dd>
        </div>
        <div class="bg-[var(--color-bg)] p-6">
          <dt class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--muted)]">
            {t(lang, "about.capitalLabel")}
          </dt>
          <dd class="mt-3 display text-3xl">{t(lang, "about.capitalValue")}</dd>
        </div>
        <div class="bg-[var(--color-bg)] p-6">
          <dt class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--muted)]">
            {t(lang, "about.expiryLabel")}
          </dt>
          <dd class="mt-3 display text-3xl">{t(lang, "about.expiryValue")}</dd>
        </div>
      </dl>
    </RevealOnScroll>
  </div>
</section>

<section class="bg-[var(--color-bg-dark)] text-[var(--color-fg-dark)]" data-theme-section="dark">
  <div class="mx-auto max-w-[100rem] px-6 py-28 md:px-10 md:py-40">
    <h2 class="display mb-12 text-3xl md:text-5xl">Operating principles</h2>
    <RevealOnScroll client:visible className="grid grid-cols-1 gap-px overflow-hidden rounded-[var(--radius-xl)] border border-white/10 bg-white/5">
      {
        values.map((v, idx) => (
          <article class="grid grid-cols-1 gap-6 bg-[var(--color-bg-dark)] p-8 md:grid-cols-12 md:p-10">
            <div class="md:col-span-2 font-mono text-xs uppercase tracking-[0.25em] text-white/45">
              {String(idx + 1).padStart(2, "0")}
            </div>
            <h3 class="display text-2xl md:col-span-4 md:text-3xl">{v.title}</h3>
            <p class="text-base text-white/65 md:col-span-6">{v.body}</p>
          </article>
        ))
      }
    </RevealOnScroll>
  </div>
</section>

<section class="relative overflow-hidden bg-[var(--color-bg-dark)] text-[var(--color-fg-dark)]" data-theme-section="dark">
  <div class="relative mx-auto flex max-w-[100rem] flex-col items-start gap-6 px-6 pb-32 md:px-10 md:pb-40">
    <h2 class="display text-balance text-4xl md:text-5xl">{t(lang, "home.cta.title")}</h2>
    <MagneticButton client:visible href={localizedHref("/contact", lang)} variant="solid">
      {t(lang, "home.cta.button")}
    </MagneticButton>
  </div>
</section>
