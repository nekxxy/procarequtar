---
import { t, tn, SERVICE_SLUGS, type Locale } from "../../i18n/utils";
import HorizontalServices from "../react/HorizontalServices.tsx";
import ServicesOrb3D from "../react/ServicesOrb3D.tsx";
import SectionHeading from "../astro/SectionHeading.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cards = SERVICE_SLUGS.map((slug, idx) => ({
  slug,
  code: tn<string>(lang, `services.list.${slug}.code`),
  title: tn<string>(lang, `services.list.${slug}.title`),
  tagline: tn<string>(lang, `services.list.${slug}.tagline`),
  index: String(idx + 1).padStart(2, "0"),
}));
---

<section class="bg-[var(--color-bg)] text-[var(--color-fg)]">
  <div class="mx-auto max-w-[100rem] px-6 pt-28 pb-12 md:px-10 md:pt-40 md:pb-20">
    <SectionHeading
      eyebrow={t(lang, "home.services.eyebrow")}
      title={t(lang, "home.services.title")}
      subtitle={t(lang, "home.services.subtitle")}
    />
  </div>
</section>

<!-- 3D services orb spanning full width before the horizontal scroll -->
<section class="relative overflow-hidden bg-[var(--color-bg-dark)]" data-theme-section="dark">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_60%_at_50%_50%,var(--color-accent)/0.15,transparent_70%)]"
  >
  </div>
  <ServicesOrb3D client:visible />
</section>

<HorizontalServices
  client:visible
  cards={cards}
  lang={lang}
  ctaLabel={t(lang, "home.projects.cta")}
/>
