---
import { t, tn, SERVICE_SLUGS, localizedHref, type Locale } from "../../i18n/utils";
import ServiceCard from "../astro/ServiceCard.astro";
import RevealOnScroll from "../react/RevealOnScroll.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<section class="bg-[var(--color-bg)] text-[var(--color-fg)] grain relative" data-theme-section="light">
  <div class="mx-auto max-w-[100rem] px-6 pb-12 pt-44 md:px-10 md:pb-20 md:pt-56">
    <span class="eyebrow inline-flex items-center gap-3">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
      Services
    </span>
    <h1 class="display mt-6 text-balance text-[clamp(2.75rem,8vw,7rem)] leading-[0.95]">
      {t(lang, "services.title")}
    </h1>
    <p class="mt-8 max-w-2xl text-lg text-[var(--muted)] md:text-xl">
      {t(lang, "services.subtitle")}
    </p>
  </div>
</section>

<section class="bg-[var(--color-bg)] text-[var(--color-fg)]">
  <div class="mx-auto max-w-[100rem] px-6 pb-32 md:px-10 md:pb-44">
    <RevealOnScroll client:visible className="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        SERVICE_SLUGS.map((slug, idx) => (
          <ServiceCard
            index={String(idx + 1).padStart(2, "0")}
            code={tn<string>(lang, `services.list.${slug}.code`)}
            title={tn<string>(lang, `services.list.${slug}.title`)}
            tagline={tn<string>(lang, `services.list.${slug}.tagline`)}
            href={localizedHref(`/services/${slug}`, lang)}
            ctaLabel={t(lang, "home.projects.cta")}
          />
        ))
      }
    </RevealOnScroll>
  </div>
</section>
