---
import { t, tn, localizedHref, type Locale, type ServiceSlug } from "../../i18n/utils";
import MobileProjectsStack from "../react/MobileProjectsStack.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface RawProject {
  title: string;
  service: ServiceSlug;
  year: string;
}
const raw = tn<RawProject[]>(lang, "projects.items").slice(0, 4);
const items = raw.map((p) => ({
  title: p.title,
  service: p.service,
  serviceLabel: tn<string>(lang, `services.list.${p.service}.title`),
  year: p.year,
}));
---

<section
  class="relative bg-[var(--color-bg-dark)] text-[var(--color-fg-dark)] px-5 py-24 md:hidden"
  data-theme-section="dark"
>
  <span class="eyebrow inline-flex items-center gap-2 text-white/65">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
    {t(lang, "home.projects.eyebrow")}
  </span>
  <h2 class="display mt-4 text-balance text-[clamp(2rem,8vw,2.75rem)] leading-[1.0]">
    {t(lang, "home.projects.title")}
  </h2>
  <p class="mt-3 text-base text-white/65">
    {t(lang, "home.projects.subtitle")}
  </p>

  <div class="mt-10">
    <MobileProjectsStack client:visible projects={items} />
  </div>

  <a
    href={localizedHref("/projects", lang)}
    class="mt-8 inline-flex h-12 items-center gap-2 rounded-full border border-white/20 px-5 text-sm font-medium"
  >
    {t(lang, "home.projects.cta")}
    <svg width="14" height="14" viewBox="0 0 18 18" fill="none" class="rtl:rotate-180" aria-hidden="true">
      <path d="M3 9h12M11 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</section>
