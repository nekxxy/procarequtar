---
import { t, tn, localizedHref, type Locale } from "../../i18n/utils";
import SectionHeading from "../astro/SectionHeading.astro";
import RevealOnScroll from "../react/RevealOnScroll.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface ProjectItem {
  title: string;
  service: string;
  year: string;
}
const items = tn<ProjectItem[]>(lang, "projects.items").slice(0, 4);
---

<section class="bg-[var(--color-bg-dark)] text-[var(--color-fg-dark)]" data-theme-section="dark">
  <div class="mx-auto grid max-w-[100rem] grid-cols-1 gap-12 px-6 py-28 md:grid-cols-12 md:px-10 md:py-40">
    <div class="md:col-span-5">
      <SectionHeading
        eyebrow={t(lang, "home.projects.eyebrow")}
        title={t(lang, "home.projects.title")}
        subtitle={t(lang, "home.projects.subtitle")}
      />
      <a
        href={localizedHref("/projects", lang)}
        data-cursor-hover
        class="mt-10 inline-flex items-center gap-2 text-sm text-[var(--color-accent)] hover:gap-3 transition-all"
      >
        {t(lang, "home.projects.cta")}
        <span aria-hidden="true" class="rtl:rotate-180">→</span>
      </a>
    </div>
    <div class="md:col-span-7">
      <RevealOnScroll client:visible className="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          items.map((item) => (
            <article class="group relative aspect-[4/5] overflow-hidden rounded-[var(--radius-lg)] border border-white/8 bg-gradient-to-br from-white/[0.04] to-white/[0.01]">
              <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,color-mix(in_srgb,var(--color-accent)_25%,transparent),transparent_60%)] opacity-50 transition-opacity duration-700 group-hover:opacity-100"
                aria-hidden="true"
              />
              <div class="relative flex h-full flex-col justify-between p-6">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-white/55">
                  {item.year} · {t(lang, `services.list.${item.service}.title`)}
                </span>
                <h3 class="display text-2xl leading-tight md:text-3xl">{item.title}</h3>
              </div>
            </article>
          ))
        }
      </RevealOnScroll>
    </div>
  </div>
</section>
