---
import { t, tn, SERVICE_SLUGS, type Locale } from "../../i18n/utils";
import MobileServicesSwiper from "../react/MobileServicesSwiper.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const cards = SERVICE_SLUGS.map((slug, idx) => ({
  slug,
  index: String(idx + 1).padStart(2, "0"),
  code: tn<string>(lang, `services.list.${slug}.code`),
  title: tn<string>(lang, `services.list.${slug}.title`),
  tagline: tn<string>(lang, `services.list.${slug}.tagline`),
  description: tn<string>(lang, `services.list.${slug}.description`),
}));
---

<section
  class="relative overflow-hidden bg-[var(--color-bg)] text-[var(--color-fg)] py-20 md:hidden"
  data-theme-section="light"
>
  <div class="px-5">
    <span class="eyebrow inline-flex items-center gap-2">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
      {t(lang, "home.services.eyebrow")}
    </span>
    <h2 class="display mt-4 text-balance text-[clamp(2rem,8vw,2.75rem)] leading-[1.0]">
      {t(lang, "home.services.title")}
    </h2>
    <p class="mt-3 text-base text-[var(--muted)]">
      {t(lang, "home.services.subtitle")}
    </p>
  </div>

  <div class="mt-10">
    <MobileServicesSwiper
      client:visible
      cards={cards}
      lang={lang}
      ctaLabel="Swipe →"
      exploreLabel={t(lang, "home.projects.cta")}
    />
  </div>
</section>
