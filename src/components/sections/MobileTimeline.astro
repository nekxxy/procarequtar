---
import { t, tn, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface Step {
  index: string;
  title: string;
  body: string;
}
const steps = tn<Step[]>(lang, "home.process.steps");
---

<section
  class="relative bg-[var(--color-bg)] text-[var(--color-fg)] px-5 py-24 md:hidden"
  data-theme-section="light"
>
  <span class="eyebrow inline-flex items-center gap-2">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
    {t(lang, "home.process.eyebrow")}
  </span>
  <h2 class="display mt-4 text-balance text-[clamp(2rem,8vw,2.75rem)] leading-[1.0]">
    {t(lang, "home.process.title")}
  </h2>
  <p class="mt-3 text-base text-[var(--muted)]">
    {t(lang, "home.process.subtitle")}
  </p>

  <ol class="mobile-timeline relative mt-12 flex flex-col gap-12">
    <span
      aria-hidden="true"
      class="absolute start-3 top-3 bottom-6 w-px bg-gradient-to-b from-[var(--color-accent)] via-[color-mix(in_srgb,var(--fg)_20%,transparent)] to-transparent"
    ></span>

    {
      steps.map((step) => (
        <li class="relative ps-12">
          <span
            aria-hidden="true"
            class="absolute start-0 top-1.5 inline-flex h-6 w-6 items-center justify-center rounded-full border border-[var(--color-accent)] bg-[var(--color-bg)]"
          >
            <span class="block h-2 w-2 rounded-full bg-[var(--color-accent)]" />
          </span>
          <div class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--muted)]">
            {step.index}
          </div>
          <h3 class="display mt-2 text-2xl">{step.title}</h3>
          <p class="mt-2 text-sm text-[var(--muted)]">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
