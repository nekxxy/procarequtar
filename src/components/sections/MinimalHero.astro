---
import { t, tn, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const tickerWords = tn<string[]>(lang, "home.sequence.hero.ticker");
const tickerLoop = [...tickerWords, ...tickerWords];
---

<section
  class="relative min-h-[100svh] overflow-hidden px-6 pb-16 pt-32 md:px-10 md:pb-24 md:pt-40"
  style="background:#1a1c1e"
  data-route-section="hero"
>
  <div class="mx-auto flex h-full max-w-[78rem] flex-col gap-10">
    <!-- Eyebrow -->
    <span
      class="inline-flex items-center gap-2.5 self-start rounded-full border border-white/15 bg-white/[0.04] px-3 py-1.5 font-mono text-[0.6rem] uppercase tracking-[0.3em] text-white/70 backdrop-blur"
    >
      <span
        class="inline-block h-1.5 w-1.5 rounded-full bg-[#FF5B1F] animate-pulse"
        aria-hidden="true"
      ></span>
      {t(lang, "home.sequence.hero.eyebrow")}
    </span>

    <!-- Headline -->
    <h1
      class="text-balance text-[clamp(2.5rem,8.5vw,7rem)] font-medium leading-[0.98] tracking-[-0.03em] text-white/90"
    >
      {t(lang, "home.sequence.hero.title")}
    </h1>

    <!-- Lead -->
    <p
      class="max-w-xl text-base text-white/60 md:text-lg"
    >
      {t(lang, "home.sequence.hero.lead")}
    </p>

    <!-- Activity-code ticker -->
    <div
      class="relative -mx-6 mt-4 overflow-hidden border-y border-white/10 py-3 md:-mx-10"
      aria-hidden="true"
    >
      <div class="hero-ticker flex w-max items-center gap-8 md:gap-12">
        {
          tickerLoop.map((w) => (
            <span class="flex shrink-0 items-center gap-8 md:gap-12">
              <span class="whitespace-nowrap font-mono text-[0.65rem] uppercase tracking-[0.3em] text-white/55">
                {w}
              </span>
              <span class="inline-block h-1 w-1 shrink-0 rounded-full bg-white/25" />
            </span>
          ))
        }
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="mt-auto flex items-end justify-between gap-6">
      <div class="flex items-center gap-3">
        <span class="scroll-cue block h-12 w-px bg-gradient-to-b from-white/40 to-transparent"></span>
        <span
          class="font-mono text-[0.6rem] uppercase tracking-[0.3em] text-white/55"
        >
          {t(lang, "home.sequence.hero.scrollCue")}
        </span>
      </div>
      <div class="font-mono text-[0.6rem] uppercase tracking-[0.25em] text-white/35">
        240 frames · 06 chapters
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .hero-ticker {
    animation: hero-ticker-scroll 28s linear infinite;
    will-change: transform;
  }
  :global([dir="rtl"]) .hero-ticker {
    animation-direction: reverse;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ticker {
      animation: none;
    }
  }

  @keyframes scrollCueFlow {
    0% {
      transform: scaleY(0);
      transform-origin: top;
      opacity: 1;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
      opacity: 1;
    }
    51% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
      opacity: 0.5;
    }
  }
  .scroll-cue {
    animation: scrollCueFlow 2.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }
  }
</style>
