---
import { t, tn, type Locale } from "../../i18n/utils";
import SectionHeading from "../astro/SectionHeading.astro";
import StatsCounter from "../react/StatsCounter.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
interface StatItem {
  value: number;
  suffix: string;
  label: string;
}
const items = tn<StatItem[]>(lang, "home.stats.items");
---

<section class="bg-[var(--color-bg-dark)] text-[var(--color-fg-dark)]" data-theme-section="dark">
  <div class="mx-auto max-w-[100rem] px-6 pb-28 md:px-10 md:pb-40">
    <SectionHeading
      eyebrow={t(lang, "home.stats.eyebrow")}
      title={t(lang, "home.about.title")}
      className="mb-16"
    />
    <StatsCounter client:visible items={items} />
  </div>
</section>
