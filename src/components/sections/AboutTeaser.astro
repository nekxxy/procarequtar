---
import { t, localizedHref, type Locale } from "../../i18n/utils";
import RevealOnScroll from "../react/RevealOnScroll.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<section class="bg-[var(--color-bg)] text-[var(--color-fg)]" data-theme-section="light">
  <div class="mx-auto grid max-w-[100rem] grid-cols-1 gap-10 px-6 py-28 md:grid-cols-12 md:gap-16 md:px-10 md:py-40">
    <div class="md:col-span-5">
      <span class="eyebrow inline-flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true" />
        {t(lang, "home.about.eyebrow")}
      </span>
    </div>
    <RevealOnScroll client:visible as="div" className="md:col-span-7 flex flex-col gap-8">
      <h2 class="display text-balance text-4xl md:text-5xl lg:text-6xl">
        {t(lang, "home.about.title")}
      </h2>
      <p class="max-w-2xl text-lg text-[var(--muted)]">
        {t(lang, "home.about.body")}
      </p>
      <a
        href={localizedHref("/about", lang)}
        data-cursor-hover
        class="mt-2 inline-flex items-center gap-2 self-start text-sm text-[var(--color-accent)] hover:gap-3 transition-all"
      >
        {t(lang, "home.about.cta")}
        <span aria-hidden="true" class="rtl:rotate-180">→</span>
      </a>
    </RevealOnScroll>
  </div>
</section>
