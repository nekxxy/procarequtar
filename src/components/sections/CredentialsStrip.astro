---
import { t, tn, type Locale } from "../../i18n/utils";
import RevealOnScroll from "../react/RevealOnScroll.tsx";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

interface Cred {
  label: string;
  value: string;
}
const items = tn<Cred[]>(lang, "home.sequence.credentials.items");
---

<section
  class="relative overflow-hidden border-t border-white/10 px-6 py-24 md:px-12 md:py-32"
  style="background:#1a1c1e"
>
  <div class="mx-auto max-w-[78rem]">
    <span
      class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.04] px-3 py-1.5 font-mono text-[0.6rem] uppercase tracking-[0.3em] text-white/70 backdrop-blur"
    >
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#FF5B1F]" aria-hidden="true"></span>
      {t(lang, "home.sequence.credentials.eyebrow")}
    </span>

    <h2
      class="mt-8 max-w-[28ch] text-balance text-[clamp(2rem,5.5vw,4rem)] font-medium leading-[1.02] tracking-[-0.025em] text-white/90"
    >
      {t(lang, "home.sequence.credentials.title")}
    </h2>

    <p class="mt-6 max-w-2xl text-base text-white/55 md:text-lg">
      {t(lang, "home.sequence.credentials.lead")}
    </p>

    <RevealOnScroll
      client:visible
      className="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] md:grid-cols-4"
    >
      {
        items.map((c) => (
          <div class="flex flex-col gap-3 bg-[#1a1c1e] px-6 py-8 md:px-8 md:py-10">
            <div class="font-mono text-[0.6rem] uppercase tracking-[0.3em] text-white/40">
              {c.label}
            </div>
            <div class="display text-2xl font-medium text-white md:text-3xl">
              {c.value}
            </div>
          </div>
        ))
      }
    </RevealOnScroll>
  </div>
</section>
