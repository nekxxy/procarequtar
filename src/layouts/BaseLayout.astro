---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import {
  getLangFromUrl,
  getDir,
  t,
  type Locale,
} from "../i18n/utils";
import SmoothScroll from "../components/react/SmoothScroll";
import Cursor from "../components/react/Cursor";
import Preloader from "../components/react/Preloader";
import MobileFAB from "../components/react/MobileFAB.tsx";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import MobileBottomNav from "../components/astro/MobileBottomNav.astro";
import MobileTopBar from "../components/astro/MobileTopBar.astro";
import { localizedHref, t as tr } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  theme?: "light" | "dark";
  /** Override locale (used by /index.astro language redirect) */
  lang?: Locale;
  /** Page-level route key — drives global CSS overrides. Use "home" for
   *  the cinematic scroll-sequence home, default "page" everywhere else. */
  route?: "home" | "page";
}

const lang = (Astro.props.lang ?? getLangFromUrl(Astro.url)) as Locale;
const dir = getDir(lang);
const title = Astro.props.title ?? t(lang, "meta.title");
const description = Astro.props.description ?? t(lang, "meta.description");
const theme = Astro.props.theme ?? "light";
const route = Astro.props.route ?? "page";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const otherLocale = lang === "en" ? "ar" : "en";

const BASE = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "");
const subPath = Astro.url.pathname
  .replace(BASE, "")
  .replace(/^\/(en|ar)/, "");
const enHref = `${BASE}/en${subPath}` || `${BASE}/en/`;
const arHref = `${BASE}/ar${subPath}` || `${BASE}/ar/`;
const faviconHref = `${BASE}/favicon.svg`;
---

<!doctype html>
<html lang={lang} dir={dir} data-theme={theme} data-route={route}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ar" href={arHref} />
    <link rel="alternate" hreflang="x-default" href={`${BASE}/en/`} />
    <link rel="sitemap" type="application/xml" href={`${BASE}/sitemap-index.xml`} />
    <link rel="manifest" href={`${BASE}/manifest.json`} />

    {/* OpenGraph + Twitter card */}
    <meta property="og:title" content={t(lang, "meta.ogTitle")} />
    <meta property="og:description" content={t(lang, "meta.ogDescription")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${BASE}/og-image.png`, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "ar" ? "ar_QA" : "en_QA"} />
    <meta property="og:site_name" content="Pro Care Qatar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t(lang, "meta.ogTitle")} />
    <meta name="twitter:description" content={t(lang, "meta.ogDescription")} />
    <meta name="twitter:image" content={new URL(`${BASE}/og-image.png`, Astro.site).toString()} />

    <meta name="theme-color" content={route === "home" ? "#1a1c1e" : theme === "dark" ? "#0b0b0a" : "#f4f1ec"} />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={faviconHref} />

    {/* LocalBusiness structured data — knowledge-panel eligibility */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": `${Astro.site}${BASE}/#business`,
      name: "Pro Care Trading Contracting and Facility Services",
      alternateName: "Pro Care Qatar",
      description: t(lang, "meta.description"),
      url: `${Astro.site}${BASE}/${lang}/`,
      telephone: "+974 0000 0000",
      email: "hello@procareqatar.com",
      image: new URL(`${BASE}/og-image.png`, Astro.site).toString(),
      logo: new URL(`${BASE}/favicon.svg`, Astro.site).toString(),
      address: {
        "@type": "PostalAddress",
        addressLocality: "Doha",
        addressCountry: "QA",
      },
      areaServed: { "@type": "Country", name: "Qatar" },
      identifier: { "@type": "PropertyValue", propertyID: "C.R.", value: "217949" },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Sunday","Monday","Tuesday","Wednesday","Thursday"],
        opens: "08:00",
        closes: "18:00",
      },
      knowsLanguage: ["en", "ar"],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Pro Care services",
        itemListElement: [
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Construction (C.R. 410029)" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Post-construction cleaning (C.R. 433091)" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Building materials retail (C.R. 475281)" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Facility maintenance (C.R. 811003)" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Pest control (C.R. 812904)" } },
        ],
      },
    })} />

    {/* Cinematic home: warm up DNS / TLS for the sequence directory and
        preload the very first frame so the canvas paints near-instantly.
        We skip the responsive variants (browser would download both); the
        ScrollSequence island then continues with the full preload graph. */}
    {route === "home" && (
      <>
        <link rel="preload" as="image" href={`${BASE}/sequence/desktop/frame-001.webp`} type="image/webp" media="(min-width: 769px)" />
        <link rel="preload" as="image" href={`${BASE}/sequence/mobile/frame-001.webp`} type="image/webp" media="(max-width: 768px)" />
      </>
    )}

    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-svh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded focus:bg-[var(--color-accent)] focus:px-3 focus:py-2 focus:text-black"
      >{t(lang, "nav.skipToContent")}</a
    >

    <SmoothScroll client:load />
    {route !== "home" && <Preloader lang={lang} client:load />}
    <Cursor client:idle />

    {route !== "home" && <Header lang={lang} otherLocale={otherLocale} />}
    <MobileTopBar lang={lang} otherLocale={otherLocale} />

    <main id="main" data-lang={lang}>
      <slot />
    </main>

    {route !== "home" && <Footer lang={lang} />}

    <!-- Mobile-only persistent shells -->
    <MobileFAB
      client:idle
      href={localizedHref("/contact", lang)}
      label={tr(lang, "home.cta.button")}
    />
    <MobileBottomNav lang={lang} />
  </body>
</html>
